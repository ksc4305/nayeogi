<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.nayeogi.recommendation.model.dao.RecommendationDao">

    <!-- survey_score 매핑 제거 -->
    <resultMap id="RecommendationResultMap"
               type="Recommendation"
               autoMapping="true">

        <id column="id" property="id"/>
        <result column="content_id" property="content_id"/>
        <result column="title" property="title"/>
        <result column="content_type_id" property="content_type_id"/>
        <result column="area_code" property="area_code"/>
        <result column="si_gun_gu_code" property="si_gun_gu_code"/>
        <result column="first_image1" property="first_image1"/>
        <result column="first_image2" property="first_image2"/>
        <result column="map_level" property="map_level"/>
        <result column="latitude" property="latitude"/>
        <result column="longitude" property="longitude"/>
        <result column="tel" property="tel"/>
        <result column="addr1" property="addr1"/>
        <result column="addr2" property="addr2"/>
        <result column="homepage" property="homepage"/>
        <result column="overview" property="overview"/>

        <!-- 주의: survey_score 매핑은 제거함 -->
        <!-- <result column="survey_score" property="survey_score"/> -->
    </resultMap>


    <select id="selectRecommendations"
            resultMap="RecommendationResultMap">

        SELECT
            a.id,
            a.content_id,
            a.title,
            a.content_type_id,
            a.area_code,
            a.si_gun_gu_code,
            a.first_image1,
            a.first_image2,
            a.map_level,
            a.latitude,
            a.longitude,
            a.tel,
            a.addr1,
            a.addr2,
            a.homepage,
            a.overview,
            COALESCE(score_summary.survey_score, 0) AS survey_score
        FROM attractions AS a
        LEFT JOIN (
            SELECT
                af.attraction_id,
                COALESCE(SUM(COALESCE(sfw.weight, 0) * COALESCE(af.score, 0)), 0) AS survey_score
            FROM attraction_features AS af
            LEFT JOIN survey_feature_weight AS sfw
                ON sfw.attraction_features_id = af.id
            <choose>
                <when test="svdIds != null and svdIds.size() > 0">
                    AND sfw.survey_id IN
                    <foreach collection="svdIds" item="id" open="(" separator="," close=")">
                        #{id}
                    </foreach>
                </when>
                <otherwise>
                    AND 1 = 0
                </otherwise>
            </choose>

            GROUP BY af.attraction_id
        ) AS score_summary
            ON score_summary.attraction_id = a.id

        ORDER BY
            score_summary.survey_score DESC,
            a.id ASC

    </select>

</mapper>
