<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
	MemberMapper.java 인터페이스와 매핑되는 XML 파일입니다.
	namespace는 매퍼 인터페이스의 전체 경로와 정확히 일치해야 합니다.
-->
<mapper namespace="com.ssafy.nayeogi.member.model.dao.MemberDao">

	<!-- 
		회원가입을 위한 INSERT 쿼리입니다.
		- DB 컬럼명(id, name, pw, email)과 DTO 필드명(userId, userName, userPassword, email)을 매핑합니다.
	-->
	<insert id="insertMember" parameterType="com.ssafy.nayeogi.member.model.dto.MemberDto">
		INSERT INTO members (id, name, pw, email) 
		VALUES (#{userId}, #{userName}, #{userPassword}, #{email})
	</insert>
	
	<!-- 
		아이디 중복 체크를 위한 SELECT 쿼리입니다.
		- id 컬럼을 기준으로 사용자가 존재하는지 확인합니다.
	-->
	<select id="idCheck" parameterType="string" resultType="int">
		SELECT COUNT(*) 
		FROM members 
		WHERE id = #{userId}
	</select>
	
	<!-- 
		로그인 확인해서 전부다 반
	 -->
	<select id="memberInfo" parameterType="string" resultType="com.ssafy.nayeogi.member.model.dto.MemberDto">
		SELECT 
			id as userId, 
			name as userName, 
			pw as userPassword, 
			email, 
			join_date as joinDate,
			role  <!-- 이거 꼭 추가해야 합니다! -->
		FROM members
		WHERE id = #{userId}
	</select>
	
	<!-- 
		회원 정보 수정입니다.
	 -->
	
	<update id="updateMember" parameterType="com.ssafy.nayeogi.member.model.dto.MemberDto">
		UPDATE members
		<set>
			<if test="userPassword != null and userPassword != ''">
				pw = #{userPassword},
			</if>
			<if test="userName != null and userName != ''">
				name = #{userName},
			</if>
			<if test="email != null and email != ''">
				email = #{email},
			</if>
			</set>
		WHERE id = #{userId}
	</update>

	<delete id="deleteMember" parameterType="string">
		DELETE FROM members
		WHERE id = #{userId}
	</delete>
	

</mapper>